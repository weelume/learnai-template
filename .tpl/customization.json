{
  "$schema": "./schemas/customization.schema.json",
  "format": "git-template-customization",
  "formatVersion": "0.2.0",
  "entries": [
    {
      "id": "brand",
      "title": "品牌与注入配置",
      "description": "修改品牌名称、标识及可选外部入口",
      "files": [
        {
          "path": "src/features/site-templates/catalog/learnai/host.tsx",
          "kind": "file",
          "purpose": "独立默认品牌和注入接口"
        }
      ],
      "constraints": [
        "不在通用源码中硬编码接入方信息。"
      ],
      "checks": [
        "typecheck",
        "lint",
        "test"
      ]
    },
    {
      "id": "content",
      "title": "双语内容与页面",
      "description": "维护内容集合、内页及导航",
      "files": [
        {
          "path": "src/features/site-templates/catalog/learnai/data.ts",
          "kind": "file",
          "purpose": "双语内容集合"
        },
        {
          "path": "src/features/site-templates/catalog/learnai/InnerPages.tsx",
          "kind": "file",
          "purpose": "内页公共组件"
        },
        {
          "path": "src/features/site-templates/catalog/learnai/pages",
          "kind": "directory",
          "purpose": "页面组合"
        }
      ],
      "constraints": [
        "两种语言同步修改。",
        "新增页面同步 meta.ts 和 template.json。",
        "演示行为必须明确，不声称已经发送表单、订阅付费或接入真实 AI。"
      ],
      "checks": [
        "typecheck",
        "lint",
        "test"
      ]
    },
    {
      "id": "theme",
      "title": "主题与响应式",
      "description": "修改主题令牌、卡片和布局",
      "files": [
        {
          "path": "src/features/site-templates/catalog/learnai/theme.css",
          "kind": "file",
          "purpose": "字体、颜色、间距与三端布局"
        },
        {
          "path": "src/features/site-templates/catalog/learnai/Mockup.tsx",
          "kind": "file",
          "purpose": "中文示意界面"
        },
        {
          "path": "src/features/site-templates/catalog/learnai/scrollbars.css",
          "kind": "file",
          "purpose": "滚动条主题、路由隔离与原生触控适配"
        }
      ],
      "constraints": [
        "遵守减少动态效果设置。",
        "维持真实 400/700 字重及中文语义换行。"
      ],
      "checks": [
        "typecheck",
        "lint",
        "build"
      ]
    },
    {
      "id": "interaction",
      "title": "交互和动效",
      "description": "修改搜索、对话、环形动画、FAQ 和菜单",
      "files": [
        {
          "path": "src/features/site-templates/catalog/learnai/LanguagePractice.tsx",
          "kind": "file",
          "purpose": "本地练习、浏览器语音及抽屉"
        },
        {
          "path": "src/features/site-templates/catalog/learnai/Sections.tsx",
          "kind": "file",
          "purpose": "区块动效"
        },
        {
          "path": "src/features/site-templates/catalog/learnai/Motion.tsx",
          "kind": "file",
          "purpose": "焦点管理、入场与日志"
        },
        {
          "path": "src/features/site-templates/catalog/learnai/Shell.tsx",
          "kind": "file",
          "purpose": "导航和语言路由"
        }
      ],
      "constraints": [
        "语音只在用户主动点击后启用。",
        "定时器、录音和语音播放在退出时清理。",
        "不得输出输入文字或身份信息。"
      ],
      "checks": [
        "typecheck",
        "lint",
        "test",
        "build"
      ]
    }
  ]
}
